    rec={"participant":pid,"video_candidates":[brief(i) for i in video],"tracker_candidates":[brief(i) for i in tracker],"browser_log_candidates":[brief(i) for i in logs],"original_video_and_reference_present":len(video)==len(tracker)==len(logs)==1,"timestamps_inspected":False}
    out["subjects"].append(rec)
   out["source_status"]="manifest_complete"
 except Exception as e:
  out["errors"].append({"type":type(e).__name__,"message":str(e)[:300]})
